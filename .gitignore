.DS_Store

# ---------------------------------------------------------------------------
# A site installed in this folder by scripts/install.sh. Your own themes, plugins and
# mu-plugins in wp-content/ stay tracked; everything else is local.
# `git clean -fdX` removes all of it (preview with `git clean -ndX`).
# ---------------------------------------------------------------------------

# WordPress core, and wp-config.php with its local salts and database settings
/wp-admin/
/wp-includes/
/index.php
/license.txt
/readme.html
/wp-*.php
/xmlrpc.php

# wp-content: keep themes/, plugins/ and mu-plugins/; ignore the rest
# (database, uploads, upgrade, Studio's db.php drop-in, ...)
/wp-content/*
!/wp-content/themes/
!/wp-content/plugins/
!/wp-content/mu-plugins/
/wp-content/themes/index.php
/wp-content/themes/twenty*/
/wp-content/plugins/index.php
/wp-content/plugins/akismet/
/wp-content/plugins/hello.php
/wp-content/mu-plugins/sqlite-database-integration/
/wp-content/mu-plugins/99-studio-loader.php

# Written by Studio (a CLAUDE.md you add yourself can still be committed
# with `git add -f CLAUDE.md`)
/STUDIO.md
/AGENTS.md
/CLAUDE.md
/.agents/
/.claude/skills/

# MySQL option: made from scripts/templates/docker-compose.yml with this machine's port
/docker-compose.yml
